# ==============================================================================
# WAYPOINT LOGISTICS PLATFORM - ENVIRONMENT CONTRACT (.env.example)
# ==============================================================================

# Node Runtime Environment
NODE_ENV=development

# Database Configuration (PostgreSQL 15)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=delivery_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres_password@postgres:5432/delivery_db

# Security & Dual-JWT Stateless Secrets
JWT_ACCESS_SECRET=waypoint_default_jwt_access_secret_key_2026_change_in_prod
JWT_REFRESH_SECRET=waypoint_default_jwt_refresh_secret_key_2026_change_in_prod

# Core Infrastructure Ports
GATEWAY_PORT=80
FRONTEND_PORT=3000

# Backend Microservice Internal Routing Ports
AUTH_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
PLANNING_SERVICE_PORT=3003
FLEET_SERVICE_PORT=3004
EXECUTION_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006

# Frontend API Gateway URL Configuration
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:80
