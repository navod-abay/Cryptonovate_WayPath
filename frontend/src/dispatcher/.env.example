# Leave empty for Vite's local /api proxy (backend ports 5001–5006).
# For deployment, set the gateway origin before building, e.g. https://api.example.com
VITE_API_BASE_URL=
# Try APIs first, then use public/data/dispatcher.json on failure.
# Set false when you want to see API errors during integration testing.
VITE_FILE_FALLBACK=true
# Default: predefined local test account. Set api to call POST /api/auth/login.
VITE_LOGIN_MODE=demo
