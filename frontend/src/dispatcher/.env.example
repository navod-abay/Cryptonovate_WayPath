# Leave empty for Vite's local /api proxy (backend ports 5001–5006).
# For deployment, set the gateway origin before building, e.g. https://api.example.com
VITE_API_BASE_URL=
# Local development only; leave unset for real behaviour (deployments never set these).
# true = on API failure, use public/data/dispatcher.json.
# VITE_FILE_FALLBACK=true
# demo = built-in test account instead of POST /api/auth/login.
# VITE_LOGIN_MODE=demo
