# Copy to .env.local and adjust.

# "true" (default): use the dummy data in src/mock, no backend needed.
# "false": call the real services through the gateway.
VITE_USE_MOCK_API=true

# Gateway origin only; the app adds /api itself (same as the dispatcher).
# Leave empty when served behind the NGINX gateway (same origin).
# For `npm run dev` against docker compose, use http://localhost
VITE_API_BASE_URL=

# Standalone RBAC Service Testing:
# To connect ONLY the Auth-RBAC microservice to the frontend while keeping
# mock data for other services:
# VITE_USE_MOCK_AUTH=false
