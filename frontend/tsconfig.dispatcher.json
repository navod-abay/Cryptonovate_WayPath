{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@waypoint/ui": ["./packages/ui/src/index.ts"], "@waypoint/ui/styles": ["./packages/ui/src/styles.css"] }
  },
  "include": ["src/dispatcher", "packages/ui/src", "vite.config.ts"]
}
