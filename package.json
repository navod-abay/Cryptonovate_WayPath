{
  "name": "@waypoint/monorepo-root",
  "version": "1.0.0",
  "private": true,
  "description": "Waypoint Group Microservices Delivery Logistics Platform Monorepo",
  "workspaces": [
    "frontend",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "dev:all": "docker compose up",
    "dev:frontend": "docker compose up frontend auth-rbac postgres gateway",
    "dev:auth": "docker compose up auth-rbac postgres",
    "dev:orders": "docker compose up order-management auth-rbac postgres"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.5.2"
  }
}
