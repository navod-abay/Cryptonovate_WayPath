# ==============================================================================
# Order Management — environment contract
# Copy to .env for running outside Docker (npm run dev). Under docker-compose the
# values come from the compose file and the repo-root .env instead.
# ==============================================================================

# ---- Required: no defaults in code. The service refuses to start without them.
PORT=
DATABASE_URL=
JWT_ACCESS_SECRET=
# Base URL of Fleet & Directory (vehicle data), without a path.
FLEET_SERVICE_URL=
# NATS JetStream server for dashboard alerts, e.g. nats://localhost:4222
NATS_URL=

# ---- Optional
NODE_ENV=development
# Comma-separated browser origins allowed to call this API. Empty = any origin.
CORS_ALLOWED_ORIGINS=
FLEET_TIMEOUT_MS=3000
FLEET_RETRY_DELAY_MS=2000
OUTLET_REFRESH_INTERVAL_MS=300000

ORDER_CUTOFF_HOUR=16
BUSINESS_TZ=Asia/Colombo
NON_OPERATING_WEEKDAYS=0
HOLIDAY_DATES=
MAX_DEFERRALS=3
AT_RISK_DAYS=3
CHILLED_TRIPS_PER_DAY=1
SEED_DEMO_DATA=true
CUTOFF_JOB_INTERVAL_MS=60000
