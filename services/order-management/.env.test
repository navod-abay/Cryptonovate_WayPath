# Placeholder configuration for unit tests and OpenAPI generation only.
# Nothing here is contacted: unit tests exercise pure logic, and the exporter only builds the spec.
# The .invalid hosts can never resolve, so a test that did try to connect would fail loudly.
NODE_ENV=test
PORT=1
DATABASE_URL=postgres://unit:unit@db.invalid/unit
JWT_ACCESS_SECRET=unit-test-only-not-a-real-secret
FLEET_SERVICE_URL=http://fleet.invalid
