# Targets for `npm run verify`. Copy to .env.verify (git-ignored) and fill in for the
# environment you are testing. Nothing is assumed: the script stops if these are missing.

# Order Management base, including the /api/orders prefix (direct, or through the gateway).
BASE_URL=
# auth-rbac base, including the /api/auth prefix. Not needed when AUTH_MODE=mint.
AUTH_URL=

# login (default) = real logins with the seeded accounts
# mint            = sign dev tokens locally with JWT_ACCESS_SECRET (use when auth-rbac is down)
AUTH_MODE=login
# Required only for AUTH_MODE=mint; must equal the secret the running service uses.
JWT_ACCESS_SECRET=
