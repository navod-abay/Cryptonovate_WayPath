{
  "name": "@waypoint/order-management",
  "version": "1.0.0",
  "description": "Order Management Microservice for the Waypoint Delivery Logistics Platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && cd dist-tests && node --env-file=../.env.test --test",
    "verify": "node scripts/verify.mjs",
    "openapi": "tsc && node --env-file=.env.test scripts/export-openapi.mjs",
    "openapi:check": "tsc && node --env-file=.env.test scripts/export-openapi.mjs --check"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.29.3",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.5.2",
    "yaml": "^2.9.1"
  }
}
